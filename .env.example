# NanoClaw Self-Hosted Configuration
# Copy this file to .env and fill in your values

# ===========================================
# REQUIRED: Telegram Bot (get from @BotFather)
# ===========================================
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather

# ===========================================
# REQUIRED: Agent Configuration
# ===========================================
# Docker image to use (one of these must be built)
CONTAINER_IMAGE=nanoclaw-agent-fast:latest

# Local server URL
SERVER_URL=http://localhost:8080

# Model name (must match what's installed in Ollama)
MODEL=stable-code:3b-code-q4_0

# ===========================================
# OPTIONAL: LM Studio instead of Ollama
# ===========================================
# CONTAINER_IMAGE=nanoclaw-agent-lmstudio:latest
# SERVER_URL=http://localhost:1234/v1/chat
# MODEL=your-lmstudio-model

# ===========================================
# OPTIONAL: Main Group Settings
# ===========================================
# TRIGGER_WORD=@Andy
# MAIN_GROUP_FOLDER=main

# ===========================================
# OPTIONAL: Advanced
# ===========================================
# CONTAINER_TIMEOUT=300000
# IDLE_TIMEOUT=180000
# LOG_LEVEL=info